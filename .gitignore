node_modules/
.expo/
dist/
web-build/

# Generated by `expo prebuild`; regenerate rather than edit by hand, or the
# config plugins in plugins/ will silently stop being the source of truth.
# Anchored with a leading slash: unanchored, these match at every level and
# swallow modules/macha-player/android/, which is hand-written Kotlin.
/android/
/ios/

# Gradle output from the native player module, whose sources are tracked.
modules/macha-player/android/build/

*.log
.DS_Store

# Scratch captures pulled off the television. Anything worth keeping goes to
# docs/evidence/ with a date, not left at the root.
/tv-*.png
/tv-*.jpg

# Per-machine agent rules. AGENTS.md is the shared, hand-written contract; the
# .local.md sibling is generated (basemind init) and belongs to one checkout.
*.local.md
